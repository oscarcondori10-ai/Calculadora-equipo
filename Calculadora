package calculadora;

import java.util.Scanner;

public class Calculadora {
    public static double sumar(double a, double b) { return a + b; }
    public static double restar(double a, double b) { return a - b; }
    public static double multiplicar(double a, double b) { return a * b; }
    public static double dividir(double a, double b) { return a / b; }
    public static double dividir(double a, double b) {
    if (b == 0) {
        System.out.println("HOTFIX: ¡Error! No se puede dividir entre 0");
        return 0.0;
    }
    return a / b;
}
    
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Introduce 2 números:");
        double num1 = scanner.nextDouble();
        double num2 = scanner.nextDouble();
        
        System.out.println("1-Suma, 2-Resta, 3-Multiplicación, 4-División");
        int opcion = scanner.nextInt();

        switch (opcion) {
            case 1: System.out.println("*** EQUIPO - SUMA *** " + sumar(num1, num2)); break;
            case 2: System.out.println("*** EQUIPO - RESTA *** " + restar(num1, num2)); break;
            case 3: System.out.println("*** EQUIPO - MULT *** " + multiplicar(num1, num2)); break;
            case 4: System.out.println("*** EQUIPO - DIV *** " + dividir(num1, num2)); break;
            default: System.out.println("Opción no válida");
        }
        scanner.close();
    }
}